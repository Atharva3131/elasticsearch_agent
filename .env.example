
# Elasticsearch connection. Replace ELASTIC_SERVER with the host/port reachable
# through the connected VPN; do not assume 127.0.0.1 unless Elasticsearch runs locally.
ELASTIC_SERVER=https://<elasticsearch-host>:9200
ELASTIC_USER=<elasticsearch-user>
ELASTIC_PASSWORD=<elasticsearch-password>
ELASTIC_VERIFY_CERTIFICATES=true
ELASTIC_INDEX=<known-index-name>

# Required for pie charts. Use an actual mapped categorical field after checking
# the live index mapping, for example marketplace if that is present.
CHART_GROUP_FIELD=<mapped-categorical-field>
APP_TIMEZONE=Asia/Kolkata

# Sarvam is the default provider.
LLM_PROVIDER=sarvam
SARVAM_API_KEY=<sarvam-api-key>
SARVAM_MODEL=sarvam-m
SARVAM_BASE_URL=https://api.sarvam.ai/v1

# Optional OpenAI fallback/provider.
OPENAI_API_KEY=<openai-api-key>
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

ELASTIC_INDEX_DATA_FROM=0
ELASTIC_INDEX_DATA_SIZE=5
ELASTIC_INDEX_DATA_MAX_SIZE=50
TOKEN_LIMIT=6000
MAX_SEARCH_RETRIES=3
AUDIT_LOG_PATH=artifacts/audit.jsonl
CHART_OUTPUT_DIR=artifacts/charts

# JWT authentication
JWT_SECRET=change-me-in-production-use-32-chars!!
JWT_EXPIRY_HOURS=8
# Users: "username:password:ROLE:seller_id" (seller_id omitted for ROLE_ADMIN)
USERS=admin:admin123:ROLE_ADMIN,seller_13:seller13pass:ROLE_USER:13,seller_1:seller1pass:ROLE_USER:1

# Guardrail policy — comma-separated role specs with pipe-separated constraints
# Format: "ROLE_X:constraint1|constraint2,ROLE_Y:constraint3"
GUARDRAIL_POLICY=ROLE_USER:can only query and access data from your assigned seller ID|cannot request data from other sellers|cannot access data outside your seller partition,ROLE_ADMIN:no restrictions

# Guard LLM timeout in seconds. 0 = rule-based only (fastest). 15 = allow 15s for LLM on ambiguous queries.
GUARD_LLM_TIMEOUT=0
